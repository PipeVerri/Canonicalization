@article{kassoufAglobinSuperenhancerActs2025,
  title = {The {$\alpha$}-Globin Super-Enhancer Acts in an Orientation-Dependent Manner},
  author = {Kassouf, Mira T. and Francis, Helena S. and Gosden, Matthew and Suciu, Maria C. and Downes, Damien J. and Harrold, Caroline and Larke, Martin and Oudelaar, Marieke and Cornell, Lucy and Blayney, Joseph and Telenius, Jelena and Xella, Barbara and Shen, Yuki and Sousos, Nikolaos and Sharpe, Jacqueline A. and {Sloane-Stanley}, Jacqueline and Smith, Andrew J. H. and Babbs, Christian and Hughes, Jim R. and Higgs, Douglas R.},
