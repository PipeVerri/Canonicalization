  langid = {english},
  keywords = {Gene expression,Molecular engineering,Transcriptional regulatory elements},
  file = {/home/pipev/Zotero/storage/DAI2G2LF/Kassouf et al. - 2025 - The α-globin super-enhancer acts in an orientation-dependent manner.pdf}
}

@article{kelleyBassetLearningRegulatory2016,
  title = {Basset: Learning the Regulatory Code of the Accessible Genome with Deep Convolutional Neural Networks},
