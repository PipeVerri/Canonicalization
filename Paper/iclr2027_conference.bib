  langid = {english},
  keywords = {Classification and taxonomy,Computational models,Computational platforms and environments,Machine learning},
  file = {/home/pipev/Zotero/storage/J485P23P/Gündüz et al. - 2023 - A self-supervised deep learning method for data-efficient training in genomics.pdf}
