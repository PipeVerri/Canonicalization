  file = {/home/pipev/Zotero/storage/NRR5ABN5/Penzar et al. - 2023 - LegNet a best-in-class deep learning model for short DNA regulatory regions.pdf}
}

@article{polakTranscriptionInducesStrandspecific2008,
  title = {Transcription Induces Strand-Specific Mutations at the 5{$\prime$} End of Human Genes},
  author = {Polak, Paz and Arndt, Peter},
  year = 2008,
  month = may,
  journal = {Genome Research},
  volume = {18},
  pages = {1216--1223},
  doi = {10.1101/gr.076570.108},
  abstract = {A regional analysis of nucleotide substitution rates along human genes and their flanking regions allows us to quantify the effect of mutational mechanisms associated with transcription in germ line cells. Our analysis reveals three distinct patterns of substitution rates. First, a sharp decline in the deamination rate of methylated CpG dinucleotides, which is observed in the vicinity of the 5{$\prime$} end of genes. Second, a strand asymmetry in complementary substitution rates, which extends from the 5{$\prime$} end to 1 kbp downstream from the 3{$\prime$} end, associated with transcription-coupled repair. Finally, a localized strand asymmetry, an excess of C{$\rightarrow$}T over G{$\rightarrow$}A substitution in the nontemplate strand confined to the first 1--2 kbp downstream of the 5{$\prime$} end of genes. We hypothesize that higher exposure of the nontemplate strand near the 5{$\prime$} end of genes leads to a higher cytosine deamination rate. Up to now, only the somatic hypermutation (SHM) pathway has been known to mediate localized and strand-specific mutagenic processes associated with transcription in mammalia. The mutational patterns in SHM are induced by cytosine deaminase, which just targets single-stranded DNA. This DNA conformation is induced by R-loops, which preferentially occur at the 5{$\prime$} ends of genes. We predict that R-loops are extensively formed in the beginning of transcribed regions in germ line cells.},
  file = {/home/pipev/Zotero/storage/SXLST9VQ/Polak and Arndt - 2008 - Transcription induces strand-specific mutations at the 5′ end of human genes.pdf}
}

@article{quangDanQHybridConvolutional2016,
  title = {{{DanQ}}: A Hybrid Convolutional and Recurrent Deep Neural Network for Quantifying the Function of {{DNA}} Sequences},
  shorttitle = {{{DanQ}}},
  author = {Quang, Daniel and Xie, Xiaohui},
