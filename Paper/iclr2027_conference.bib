@article{arnoldDiversityEmergingRoles2020,
  title = {Diversity and {{Emerging Roles}} of {{Enhancer RNA}} in {{Regulation}} of {{Gene Expression}} and {{Cell Fate}}},
  author = {Arnold, Preston R. and Wells, Andrew D. and Li, Xian C.},
  year = 2020,
